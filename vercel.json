{
  "buildCommand": "PUBLIC_URL=/ npm run build",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/laboratorio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/laboratorio/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
